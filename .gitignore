# GitHub rejects regular Git files over 100 MB, and Git LFS files over 2 GB.
*.gguf
KBA_AI/작업방/local_rag/models/bge-m3/pytorch_model.bin
KBA_AI/작업방/local_rag/models/bge-m3/onnx/model.onnx_data

# 실행 파일 빌드 결과와 캐시
__pycache__/
*.py[cod]
.pytest_cache/
KBA_AI/작업방/pdf분할병합/pdf_tool/build/
KBA_AI/작업방/pdf분할병합/pdf_tool/dist/

# 로컬 비밀키와 실행 중 생긴 데이터베이스
KBA_AI/작업방/아나바다/instance/secret_key
KBA_AI/작업방/아나바다/instance/*.db
KBA_AI/작업방/아나바다/static/uploads/*
!KBA_AI/작업방/아나바다/static/uploads/.gitkeep

# 노트북 실행 중 생기는 벡터 DB (Chroma)
KBA_AI/실습코드/database/

# 로컬 RAG 실행 중 생기는 업로드 PDF와 벡터 DB
KBA_AI/작업방/local_rag/uploads/
KBA_AI/작업방/local_rag/chroma_db/

# 계약서 검토 웹 실행 중 생기는 업로드 PDF와 벡터 DB
KBA_AI/작업방/계약서검토/uploads/
KBA_AI/작업방/계약서검토/chroma_db/

# 환경변수(비밀키)와 실행 중 생기는 DB·분석 결과
KBA_AI/작업방/재고관리시스템/.env
KBA_AI/작업방/재고관리시스템/inventory.db
KBA_AI/작업방/뉴스수집/.env
KBA_AI/작업방/고객voc분석/outputs/
